# --- Cielo API E-Commerce 3.0 ---
# Gere MerchantId e MerchantKey no portal da Cielo.
CIELO_MERCHANT_ID=
CIELO_MERCHANT_KEY=
CIELO_ENVIRONMENT=sandbox
CIELO_TIMEOUT_MS=20000

# Aparece na fatura do cartao. Maximo 13 caracteres alfanumericos.
CIELO_SOFT_DESCRIPTOR=IPPS

# --- Boleto ---
# Provider: Bradesco2 ou BancoDoBrasil2, conforme o contrato do IPPS.
CIELO_BOLETO_PROVIDER=Bradesco2
CIELO_BOLETO_ASSIGNOR=IPPS
# CNPJ do cedente, so digitos.
CIELO_BOLETO_IDENTIFICATION=
CIELO_BOLETO_INSTRUCTIONS=Aceitar somente ate a data de vencimento.
CIELO_BOLETO_EXPIRATION_DAYS=3

# --- Post de Notificacao (webhook) ---
# A Cielo NAO assina o webhook. A unica protecao e um header estatico, que
# precisa ser cadastrado junto ao Suporte Cielo com a URL de notificacao.
# A URL cadastrada deve ser estatica e ter no maximo 255 caracteres.
CIELO_NOTIFICATION_HEADER_NAME=
CIELO_NOTIFICATION_HEADER_VALUE=

# --- Aplicacao ---
APP_BASE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001
VITE_API_BASE_URL=
PORT=3001
PRIVACY_TERMS_VERSION=2026-07-05

DONATION_MIN_VALUE=5
DONATION_MAX_VALUE=10000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=600000
